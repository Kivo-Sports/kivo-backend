# Local development on macOS uses Docker + Azure SQL Edge.
# Copy this file to .env and keep MSSQL_SA_PASSWORD equal to the Password in DB_CONNECTION_STRING.

MSSQL_SA_PASSWORD=SuaSenhaForte123
DB_CONNECTION_STRING=Server=localhost,1433;Database=KivoDb;User Id=sa;Password=SuaSenhaForte123;TrustServerCertificate=True;

JWT_KEY=dev-only-change-me-minimum-32-characters
JWT_ISSUER=kivoBackend
JWT_AUDIENCE=kivoFrontEnd

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
SENDER_NAME=Kivo Sports
ENABLE_SSL=true

FIREBASE_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=

ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Mesmo valor do "Token de autenticação" do webhook no painel do Asaas.
# Quando definido, POST /api/webhook/asaas exige o cabeçalho asaas-access-token (vazio = aceita sem token).
ASAAS_WEBHOOK_TOKEN=

# Produção (Azure App Service) — configurar nas variáveis de ambiente do App Service
# APPLY_MIGRATIONS=true          # aplica as migrations do EF no startup
# ENABLE_SWAGGER=false           # true para expor /swagger fora do Development
# ADMIN_EMAIL=                   # admin criado no primeiro startup (padrão: admin@kivo.com)
# ADMIN_PASSWORD=                # senha desse admin (padrão: Admin@123456)
# FIREBASE_CREDENTIALS_JSON=     # conteúdo do firebase-key.json (substitui GOOGLE_APPLICATION_CREDENTIALS)
