# ╔════════════════════════════════════════════════════════════════════╗
# ║  Kivo Sports — Backend  (.env)                                     ║
# ║  Copie este arquivo para `.env` e preencha os valores.             ║
# ║  O `.env` é ignorado pelo git — NÃO comite segredos.               ║
# ╚════════════════════════════════════════════════════════════════════╝

# ── Ambiente ──────────────────────────────────────────────────────────
# Development (local) ou Production (servidor).
# Em Production o app EXIGE JWT_KEY forte e DB_CONNECTION_STRING:
# ele FALHA ao iniciar se faltarem ou se a JWT_KEY for a padrão de dev.
ASPNETCORE_ENVIRONMENT=Development

# ── Banco de dados (SQL Server) ───────────────────────────────────────
# Dev (LocalDB / SQLEXPRESS):
DB_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=KivoDb;Trusted_Connection=True;TrustServerCertificate=True;Connection Timeout=30;
# Produção (exemplo com login dedicado — use um usuário de menor privilégio):
# DB_CONNECTION_STRING=Server=SEU_SERVIDOR;Database=KivoDb;User Id=kivo_app;Password=SENHA_FORTE;TrustServerCertificate=True;Connection Timeout=30;

# ── JWT ───────────────────────────────────────────────────────────────
# Em produção use uma chave ALEATÓRIA e FORTE (mínimo 32 caracteres).
# NÃO reutilize a chave de desenvolvimento.
JWT_KEY=troque-por-uma-chave-aleatoria-de-32-ou-mais-caracteres
JWT_ISSUER=kivoBackend
JWT_AUDIENCE=kivoFrontEnd

# ── Admin inicial (seed automático) ───────────────────────────────────
# SEED_ADMIN=false desliga a criação automática do admin.
# Em produção, SEM ADMIN_PASSWORD definido, o admin NÃO é criado
# (evita uma senha-padrão conhecida no servidor).
SEED_ADMIN=true
ADMIN_EMAIL=admin@kivo.com
# ADMIN_PASSWORD=DefinaUmaSenhaForte@2026   # obrigatório em produção p/ criar o admin

# ── E-mail (SMTP / Gmail App Password) ────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=seu-email@gmail.com
SENDER_PASSWORD=sua-app-password-do-gmail
SENDER_NAME=Kivo Sports
ENABLE_SSL=true

# ── CORS ──────────────────────────────────────────────────────────────
# Origens do frontend separadas por vírgula.
# Em produção (VPN), use o endereço pelo qual o frontend é acessado.
# Ex.: http://10.8.0.2:3000  (IP do frontend na VPN)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Servidor / rede ───────────────────────────────────────────────────
# Swagger: em produção fica desligado por padrão. Ligue (true) se quiser testar pela VPN.
ENABLE_SWAGGER=false
# Redirecionamento HTTPS: desligado (acesso por VPN em HTTP).
# Quando for adotar HTTPS, defina true.
USE_HTTPS_REDIRECT=false

# ── Firebase Storage (logos / imagens) ────────────────────────────────
# O arquivo de credenciais (firebase-key.json) também é ignorado pelo git.
FIREBASE_BUCKET="seu-bucket.firebasestorage.app"
GOOGLE_APPLICATION_CREDENTIALS="firebase-key.json"
